@Article{Leonardis2026,
  author    = {Leonardis, Eric J. and Oline, Stefan N. and Tang, Isaac and Park, Joshua and Mimica, Bartul and Maree, Liezl and Afshar, Shayan and Timmermans, Olivia and Jiang, Jinrun and Whitmire, Eliza and Zhu, Aaron and Wines, Talisa and Tye, Kay M. and Murthy, Mala and Falkner, Annegret L. and Pereira, Talmo D.},
  journal   = {bioRxiv},
  title     = {LUC3D: Multi-animal 3D pose tracking in the browser},
  year      = {2026},
  month     = nov,
  abstract  = {Animal behavior unfolds in three dimensions over time, yet accessible scientific tools for analyzing it in its natural form remain limited. Uncertainty from popular 2D pose methods can be refined with multi-camera approaches to produce more accurate 3D estimates. This paper presents LUC3D (Label Unification and Correspondence in 3D Annotation GUI), a browser-based 3D GUI for reducing the amount of manual labor required for labeling, proofreading, and multi-camera multi-animal tracking while requiring no installation to maximize accessibility. As proof-of-concept we present two datasets of proofread multi-camera 3D triangulated pose data of mouse social behavior, a protocol for generating 3D consistent labels, and a cross-view re-identification tracking algorithm for multi-animal multi-camera pose data. This tool allows for the widespread adoption of 3D pose estimation techniques for studying social behavior while reducing the cost of entry for neuroscience labs across the world.},
  copyright = {Creative Commons Attribution 4.0 International (CC BY 4.0)},
  doi       = {10.64898/2026.11.17.767188},
  keywords  = {Animal behavior and cognition},
  language  = {en},
  note      = {Preprint},
  publisher = {Cold Spring Harbor Laboratory},
  url       = {https://www.biorxiv.org/content/10.64898/2026.11.17.767188v1},
  urldate   = {2026-11-18},
}
